# =============================================================================
# Monitor de Inteligência Geopolítica Operacional — variáveis de ambiente
# Copie este arquivo para `.env` e preencha. NUNCA comite o .env com chaves.
# =============================================================================

# --- Cérebro (análise + impacto): escolha UM provedor ---
# LLM_PROVIDER: "auto" escolhe na ordem gemini > openrouter > anthropic,
# senão roda em DEMO. Force com "gemini", "openrouter", "anthropic" ou "demo".
LLM_PROVIDER=auto

# Opção 1 — Gemini (tem faixa GRATUITA; opção mais barata)
# Gere a chave em https://aistudio.google.com/apikey (começa com "AIza...").
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# Opção 2 — OpenRouter (um endpoint para testar várias IAs: GPT, Gemini, Llama...)
# Chave em https://openrouter.ai/keys ; modelos em https://openrouter.ai/models
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openrouter/auto

# Opção 3 — Anthropic (alternativa)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# --- Telegram (entrega) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# --- Google Sheets (entrega via gspread) ---
# Caminho para o arquivo JSON da service account (mantido FORA do repositório).
GOOGLE_SA_JSON_PATH=./secrets/google-service-account.json
# ID da planilha de destino (parte da URL: .../spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
GOOGLE_SHEETS_WORKSHEET=Briefings

# --- Orquestração / agendamento (produção) ---
# Cron no formato APScheduler (min hora dia mês dia-semana). Ex.: 07:00 todo dia útil.
SCHEDULE_CRON=0 7 * * mon-fri
TIMEZONE=America/Sao_Paulo

# --- Pipeline ---
# Quantos eventos top-relevância recebem o bloco de impacto operacional (Fase 3).
TOP_N_EVENTS=10
# Quantos eventos (pré-filtrados de graça) vão para a IA classificar — controla custo.
AI_MAX_EVENTS=50
LOG_LEVEL=INFO
# Idiomas do briefing (gera um por idioma). Ex.: "pt" ou "pt,en".
IDIOMAS=pt,en
